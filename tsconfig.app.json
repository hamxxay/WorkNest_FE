/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/app",
    "types": []
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/**/*.spec.ts",
    "src/environments/environment.prod.ts",
    "src/app/services/location.service.ts",
    "src/app/components/policies/policies.component.ts",
    "src/app/guards/checkout.guard.ts",
    "src/app/guards/receptionist.guard.ts",
    "src/app/services/availability.service.ts",
    "src/app/services/pricing.service.ts",
    "src/app/utils/space-assignment.ts",
    "src/app/utils/workspace-discount.ts"
  ]
}
